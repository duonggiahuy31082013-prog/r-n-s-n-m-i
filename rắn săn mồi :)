import streamlit as st
import streamlit.components.v1 as components

# Thiết lập cấu hình trang
st.set_page_config(page_title="Snake Game - Modern Edition", page_icon="🐍", layout="centered")

st.markdown("""
    <h1 style='text-align: center; color: #00ffcc;'>🐍 Game Rắn Săn Mồi (Modern Style)</h1>
    <p style='text-align: center;'>Sử dụng các phím <b>Mũi tên</b> hoặc <b>W, A, S, D</b> để điều khiển rắn. Nhấn <b>Play Again</b> hoặc tải lại trang để chơi lại khi thua!</p>
""", unsafe_allow_html=True)

# Mã nguồn HTML/JS của game được thiết kế mượt mà tương tự snake-game.io
snake_game_html = """
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Snake Game</title>
    <style>
        body {
            background-color: transparent;
            color: white;
            font-family: sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
        }
        #game-container {
            text-align: center;
            position: relative;
        }
        canvas {
            border: 4px solid #00ffcc;
            background-color: #1a1a1a;
            box-shadow: 0 0 25px rgba(0, 255, 204, 0.4);
            border-radius: 12px;
        }
        .scoreboard {
            display: flex;
            justify-content: space-between;
            width: 400px;
            margin: 0 auto 12px auto;
            font-size: 18px;
            font-weight: bold;
            color: #fff;
        }
        #game-over {
            display: none;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(15, 15, 15, 0.95);
            padding: 25px 40px;
            border: 2px solid #ff4b4b;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 0 30px rgba(255, 75, 75, 0.5);
        }
        button {
            background-color: #00ffcc;
            color: #000;
            border: none;
            padding: 10px 24px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            margin-top: 15px;
            transition: 0.2s;
        }
        button:hover {
            background-color: #00b386;
            transform: scale(1.05);
        }
    </style>
</head>
<body>

<div id="game-container">
    <div class="scoreboard">
        <div>Điểm: <span id="score" style="color: #00ffcc;">0</span></div>
        <div>Điểm cao: <span id="high-score" style="color: #ffcc00;">0</span></div>
    </div>
    <canvas id="snakeCanvas" width="400" height="400"></canvas>
    
    <div id="game-over">
        <h2 style="color: #ff4b4b; margin-top: 0;">💥 GAME OVER</h2>
        <p style="font-size: 16px;">Điểm của bạn: <span id="final-score" style="font-weight: bold;">0</span></p>
        <button onclick="resetGame()">Chơi Lại</button>
    </div>
</div>

<script>
    const canvas = document.getElementById("snakeCanvas");
    const ctx = canvas.getContext("2d");

    const tileCount = 20;
    const tileSize = canvas.width / tileCount;

    let snake = [
        {x: 10, y: 10},
        {x: 10, y: 11},
        {x: 10, y: 12}
    ];
    let food = {x: 5, y: 5};
    let dx = 0;
    let dy = -1;
    let score = 0;
    let highScore = localStorage.getItem("snakeHighScore") || 0;
    document.getElementById("high-score").innerText = highScore;

    let changingDirection = false;
    let gameInterval = null;

    function main() {
        if (hasGameEnded()) {
            document.getElementById("final-score").innerText = score;
            document.getElementById("game-over").style.display = "block";
            clearInterval(gameInterval);
            return;
        }

        changingDirection = false;
        clearCanvas();
        drawFood();
        moveSnake();
        drawSnake();
    }

    function startGame() {
        gameInterval = setInterval(main, 100);
        generateFood();
    }

    function clearCanvas() {
        ctx.fillStyle = "#161b22";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    function drawSnake() {
        snake.forEach((part, index) => {
            ctx.fillStyle = index === 0 ? "#00ffcc" : "#2ecc71";
            ctx.shadowBlur = index === 0 ? 12 : 0;
            ctx.shadowColor = "#00ffcc";
            ctx.fillRect(part.x * tileSize + 1, part.y * tileSize + 1, tileSize - 2, tileSize - 2);
        });
        ctx.shadowBlur = 0;
    }

    function moveSnake() {
        const head = {x: snake[0].x + dx, y: snake[0].y + dy};
        snake.unshift(head);

        if (head.x === food.x && head.y === food.y) {
            score += 10;
            document.getElementById("score").innerText = score;
            if (score > highScore) {
                highScore = score;
                localStorage.setItem("snakeHighScore", highScore);
                document.getElementById("high-score").innerText = highScore;
            }
            generateFood();
        } else {
            snake.pop();
        }
    }

    function generateFood() {
        food.x = Math.floor(Math.random() * tileCount);
        food.y = Math.floor(Math.random() * tileCount);

        snake.forEach(part => {
            if (part.x === food.x && part.y === food.y) {
                generateFood();
            }
        });
    }

    function drawFood() {
        ctx.fillStyle = "#ff4b4b";
        ctx.shadowBlur = 12;
        ctx.shadowColor = "#ff4b4b";
        ctx.fillRect(food.x * tileSize + 2, food.y * tileSize + 2, tileSize - 4, tileSize - 4);
        ctx.shadowBlur = 0;
    }

    function hasGameEnded() {
        for (let i = 4; i < snake.length; i++) {
            if (snake[i].x === snake[0].x && snake[i].y === snake[0].y) return true;
        }
        return snake[0].x < 0 || snake[0].x >= tileCount || snake[0].y < 0 || snake[0].y >= tileCount;
    }

    function changeDirection(event) {
        const keyPressed = event.keyCode;
        const LEFT = 37, UP = 38, RIGHT = 39, DOWN = 40;
        const W = 87, A = 65, S = 83, D = 68;

        if (changingDirection) return;

        if ((keyPressed === LEFT || keyPressed === A) && dx === 0) {
            dx = -1; dy = 0; changingDirection = true;
        }
        if ((keyPressed === UP || keyPressed === W) && dy === 0) {
            dx = 0; dy = -1; changingDirection = true;
        }
        if ((keyPressed === RIGHT || keyPressed === D) && dx === 0) {
            dx = 1; dy = 0; changingDirection = true;
        }
        if ((keyPressed === DOWN || keyPressed === S) && dy === 0) {
            dx = 0; dy = 1; changingDirection = true;
        }
    }

    document.addEventListener("keydown", changeDirection);
    startGame();

    function resetGame() {
        snake = [
            {x: 10, y: 10},
            {x: 10, y: 11},
            {x: 10, y: 12}
        ];
        score = 0;
        document.getElementById("score").innerText = score;
        dx = 0;
        dy = -1;
        document.getElementById("game-over").style.display = "none";
        startGame();
    }
</script>
</body>
</html>
"""

# Hiển thị game với khung nhìn mượt mà
components.html(snake_game_html, height=480, scrolling=False)
